{
  "manifest_version": 3,
  "name": "Q-clock-AI",
  "version": "1.0.0",
  "description": "Boost AI reasoning, run code sandbox, and integrate IDE directly on AI websites.",
  "permissions": ["storage", "alarms", "activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://perplexity.ai/*",
    "https://huggingchat.co/*",
    "https://poe.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://perplexity.ai/*",
        "https://huggingchat.co/*",
        "https://poe.com/*",
        "https://openrouter.ai/*"
      ],
      "js": [
        "utils/storage.js",
        "content/platform-detector.js",
        "content/reasoning-boost.js",
        "content/sandbox.js",
        "content/ui-injector.js",
        "content/native-bridge.js",
        "content/content.js"
      ],
      "css": ["styles/injected.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
